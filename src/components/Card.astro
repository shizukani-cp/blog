---
interface Props {
  artitcle: object;
  tag?: string; // tagのページを開いている場合に指定。除外される。
  }

const {article, tag} = Astro.props;
const formatDate = (date: Date) => {
  return date.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-');
};
---
<div class="card relative">
  <a href={`/blog/articles/${article.id}/`} class="no-underline after:absolute after:inset-0">
      <h3>{article.data.title}</h3>
  </a>
  <p>{article.data.description}</p>
  {article.data.tags && article.data.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-3 relative z-10">
      {article.data.tags.map((t) => (t === tag ? undefined :
        <a href={`/blog/tags/${t}/`} class="text-xs bg-gray-800 text-blue-400 px-2 py-0.5 rounded border border-gray-700 no-underline">
          #{t}
        </a>
      ))}
    </div>
  )}

  <small>{formatDate(article.data.date)}</small>
</div>
